[Unit]
Description=Flask API for websocket-realtime-lab
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/websocket-realtime-lab
Environment="PATH=/opt/websocket-realtime-lab/venv/bin"
ExecStart=/opt/websocket-realtime-lab/venv/bin/gunicorn \
    --bind 0.0.0.0:5000 --workers 1 --threads 4 \
    --access-logfile - --error-logfile - \
    app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
