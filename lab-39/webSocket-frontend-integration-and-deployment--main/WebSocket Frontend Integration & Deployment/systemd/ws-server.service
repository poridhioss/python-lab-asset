[Unit]
Description=WebSocket bridge for websocket-realtime-lab
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/websocket-realtime-lab
Environment="PATH=/opt/websocket-realtime-lab/venv/bin"
ExecStart=/opt/websocket-realtime-lab/venv/bin/uvicorn \
    ws_server:app --host 0.0.0.0 --port 5556 --log-level info
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
