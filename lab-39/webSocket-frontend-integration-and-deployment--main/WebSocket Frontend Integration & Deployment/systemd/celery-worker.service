[Unit]
Description=Celery worker for websocket-realtime-lab
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/websocket-realtime-lab
Environment="PATH=/opt/websocket-realtime-lab/venv/bin"
ExecStart=/opt/websocket-realtime-lab/venv/bin/celery \
    -A celery_app.celery_app worker \
    --loglevel=info --concurrency=2 -E
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
